{
  "name": "@achinet/nestjs-async",
  "version": "0.2.0",
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "clean": "rimraf dist",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --runInBand --config test/configs/jest-e2e.config.js",
    "start:sample": "nest start",
    "start:sample:watch": "nest start --watch"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testPathIgnorePatterns": [
      "dist/"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            }
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/microservices": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/testing": "11.2.8",
    "@nestjs/websockets": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/lodash": "^4.17.27",
    "@types/node": "25.9.9",
    "@types/supertest": "6.0.3",
    "@types/url-join": "5.0.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.7",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "reflect-metadata": "0.2.2",
    "release-it": "19.2.4",
    "rimraf": "^6.1.4",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@asyncapi/react-component": "^3.2.3",
    "@swc/core": "1.16.22",
    "js-yaml": "4.3.2",
    "lodash": "^4.18.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.14",
    "@nestjs/core": "^11.1.14",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/websockets": "^11.1.14",
    "reflect-metadata": "^0.1.12 || ^0.2.0"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "peerDependenciesMeta": {
    "@nestjs/websockets": {
      "optional": true
    }
  }
}
