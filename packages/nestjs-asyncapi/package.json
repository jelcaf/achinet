{
  "name": "@achinet/nestjs-async",
  "version": "0.1.1",
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "clean": "rimraf dist",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --runInBand --config test/configs/jest-e2e.config.js"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testPathIgnorePatterns": [
      "dist/"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            }
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@asyncapi/generator$": "<rootDir>/test/__mocks__/@asyncapi/generator.js"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/microservices": "11.1.14",
    "@nestjs/platform-express": "11.1.14",
    "@nestjs/platform-fastify": "11.1.14",
    "@nestjs/platform-socket.io": "11.1.14",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.14",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/lodash": "^4.17.23",
    "@types/node": "25.3.0",
    "@types/supertest": "6.0.3",
    "@types/url-join": "5.0.0",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "eslint": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "lint-staged": "16.2.7",
    "prettier": "3.8.1",
    "release-it": "19.2.4",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@asyncapi/generator": "^3.1.2",
    "@asyncapi/html-template": "^3.5.5",
    "@nestjs/common": "^11.1.14",
    "@nestjs/core": "^11.1.14",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/websockets": "^11.1.14",
    "@swc/core": "1.15.11",
    "js-yaml": "4.1.1",
    "lodash": "^4.17.23",
    "reflect-metadata": "0.2.2"
  }
}
