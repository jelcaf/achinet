{
  "name": "achinet",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "spikes/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --env-mode=loose",
    "lint": "turbo run lint --env-mode=loose",
    "lint:fix": "turbo run lint:fix --env-mode=loose",
    "test": "turbo run test --env-mode=loose",
    "dev": "turbo run dev --env-mode=loose",
    "changeset": "changeset",
    "release:dry": "yarn changeset publish --dry-run",
    "release": "yarn changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^25.9.9",
    "madge": "^8.0.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "@nestjs/platform-fastify/fastify": "^5.12.2",
    "@nestjs/platform-express/multer": "^2.5.0",
    "socket.io-adapter/ws": "^8.21.0",
    "engine.io-client/ws": "^8.21.0",
    "@angular-devkit/core/picomatch": "^4.0.7"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "packageManager": "yarn@4.10.3",
  "main": "index.js",
  "license": "UNLICENSED"
}
